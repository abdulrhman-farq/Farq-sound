FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg \
      libsndfile1 \
      rubberband-cli \
      build-essential \
      libsamplerate0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY apps/api/requirements.txt apps/api/requirements-worker.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-worker.txt

COPY apps/api/app /app/app
COPY apps/api/assets /app/assets

# Bake the placeholder Hijaz/daff demo catalog into the image so the
# rendering pipeline has real WAVs to slice + mix from. Replace via the
# admin intake flow once licensed material is available.
RUN python /app/assets/make_demo_audio.py && ls -la /app/storage/songs/

ENV PYTHONUNBUFFERED=1 \
    STORAGE_ROOT=/storage

CMD ["celery", "-A", "app.workers.celery_app", "worker", "-l", "info", "--concurrency=1", "--max-memory-per-child=420000"]
