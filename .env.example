# =========================
# Farq Sound — environment
# =========================
# Any provider whose key is empty falls back to deterministic mock mode.

# ---- App ----
APP_NAME=farq-sound
APP_ENV=development                # development | staging | production
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
LOG_LEVEL=info

# ---- Supabase ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=farq-sound

# For local SQL apply / migrations
DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres

# ---- Redis / Celery ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---- ElevenLabs (TTS / voice clone) ----
# Empty => provider runs in MOCK mode (silent WAV stub)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ---- Moyasar (payments) ----
# Empty => provider runs in MOCK mode (auto-approves)
MOYASAR_API_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_WEBHOOK_SECRET=

# ---- WhatsApp Cloud API ----
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_DELIVERY=farq_sound_delivery

# ---- Resend (email fallback) ----
RESEND_API_KEY=
RESEND_FROM="Farq Sound <hello@farqsound.sa>"

# ---- Public Next.js vars ----
NEXT_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
NEXT_PUBLIC_API_BASE_URL=${API_BASE_URL}
NEXT_PUBLIC_BRAND_NAME=Farq Sound
NEXT_PUBLIC_BRAND_NAME_AR=فرق ساوند

# ---- Observability (optional) ----
SENTRY_DSN_WEB=
SENTRY_DSN_API=
